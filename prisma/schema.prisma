generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  userIdRef    String?    @unique
  password     String
  phone        String?
  photo        String?    
  jobTitle     String?
  gradeLevel   String?
  role         Role       @default(STAFF)
  staffId      String?    @unique
  departmentId String?
  unitId       String?
  department   Department? @relation(fields: [departmentId], references: [id])
  unit         Unit?       @relation(fields: [unitId], references: [id])
  dailyLogs    DailyLog[]
  hrResolvedLogs DailyLog[] @relation("HRResolvedLogs")
  proxyLoggedLogs DailyLog[] @relation("ProxyLoggedBy")  //ADD THIS
  supervisedLogs DailyLog[] @relation("SupervisorLogs")
  supervisorId   String?
  supervisor     User?    @relation("StaffSupervisor", fields: [supervisorId], references: [id])
  supervises     User[]   @relation("StaffSupervisor")
  notifications Notification[]
  auditLogs    AuditLog[]
  internLogs      InternLog[]
  leaveRequests LeaveRequest[]
  examAttempts  ExamAttempt[]
  isActive     Boolean     @default(true)
  assignedTasks   Task[]  @relation("AssignedTasks")
  createdTasks    Task[]  @relation("CreatedTasks")
  checkIns     CheckIn[]
  announcements Announcement[]
  chatParticipants ChatParticipant[]
  chatMessages     ChatMessage[]
  lastSeen         DateTime?
  chatPin          String?
  chatReactions    ChatReaction[]
  memos          Memo[]
  receivedMemos  MemoRecipient[]
  submittedRevenue  RevenueItem[]  @relation("SubmittedRevenue")
  reviewedRevenue   RevenueItem[]  @relation("ReviewedRevenue")
  evcAnnotations    EVCAnnotation[]  @relation("EVCAnnotations")
  evcVaultFiles     EVCVaultFile[]   @relation("EVCVault")
  evcTasksAssigned  EVCTask[]        @relation("EVCAssignedTasks")
  evcTasksCreated   EVCTask[]        @relation("EVCCreatedTasks")
  raisedPayments    PaymentWorkflow[] @relation("RaisedPayments")
  confirmedPayments PaymentWorkflow[] @relation("ConfirmedPayments")
  initiatedTransfers CaseTransfer[] @relation("InitiatedTransfers")
  acceptedTransfers  CaseTransfer[] @relation("AcceptedTransfers")
  targetTransfers    CaseTransfer[] @relation("TargetTransfers")
  forwardedFromTasks Task[] @relation("ForwardedFrom")
  forwardedToTasks   Task[] @relation("ForwardedTo")
  webAuthnCredentials   WebAuthnCredential[]
  biometricActivations  BiometricActivationCode[] @relation("UserActivations")
  biometricCodesCreated BiometricActivationCode[] @relation("CreatedActivations")
  consentRecords        ConsentRecord[]
  faceData    FaceData?  
  biometricAttempts   BiometricAttempt[]
  hrApprovalsReceived HRCheckInApproval[] @relation("StaffHRApprovals")
  hrApprovalsGiven    HRCheckInApproval[] @relation("HRApprovers")
  otpCodes            OtpCode[]
  screenShareRequests  ScreenShareSession[] @relation("ScreenShareRequests")
  screenShareTargets   ScreenShareSession[] @relation("ScreenShareTargets")
  incentiveRecommendations IncentiveRecommendation[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  shortCode   String   @unique
  category    DeptCategory
  description String?
  headId      String?
  units       Unit[]
  users       User[]
  kpis        KPI[]
  taskTemplates TaskTemplate[]
  tasks           Task[]
  createdAt   DateTime @default(now())
}

model Unit {
  id           String     @id @default(cuid())
  name         String
  shortCode    String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]
  createdAt    DateTime   @default(now())
  @@unique([departmentId, shortCode])
}

model TaskTemplate {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  title        String
  description  String?
  requiresEvidence Boolean @default(false)
  requiresCaseRef  Boolean @default(false)
  requiresAmount   Boolean @default(false)
  category     String
  createdAt    DateTime   @default(now())
}

model DailyLog {
  id               String    @id @default(cuid())
  refNo            String?   @unique
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  date             DateTime  @default(now())
  taskTitle        String
  taskCategory     String
  taskType         String?
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  description      String
  timeSpent        Float
  priority         Priority  @default(MEDIUM)
  status           LogStatus @default(SUBMITTED)
  caseReference    String?
  amountInvolved   Float?
  evidence         String?
  notes            String?
  supervisorId     String?
  supervisor       User?     @relation("SupervisorLogs", fields: [supervisorId], references: [id])
  supervisorComment String?
  supervisorScore  Int?
  reviewedAt       DateTime?
  isAiQuickCapture Boolean   @default(false)
  quickCaptureBatch String?
  loggedByProxy    Boolean   @default(false)   //ADDED
  proxyLoggedById  String?                     //ADDED
  proxyLoggedBy    User?      @relation("ProxyLoggedBy", fields: [proxyLoggedById], references: [id])  //ADD THIS
  crossDeptFlag    String?
  ackStatus        String?
  hrResolutionNote String?
  hrResolvedAt     DateTime?
  hrResolvedById   String?
  hrResolvedBy     User?     @relation("HRResolvedLogs", fields: [hrResolvedById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  @@index([userId, date])
  @@index([userId, createdAt])
  @@index([status])
  @@index([ackStatus])
}

model KPI {
  id           String     @id @default(cuid())
  title        String
  description  String?
  target       Float
  current      Float      @default(0)
  unit         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  period       Period     @default(MONTHLY)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime   @default(now())
  snapshots    KPISnapshot[]
  goalId     String?
  goal       OrgGoal? @relation(fields: [goalId], references: [id])
  sourceType String   @default("MANUAL")   // "MANUAL" | "AUTO_REVENUE"
}

model KPISnapshot {
  id           String   @id @default(cuid())
  kpiId        String
  kpi          KPI      @relation(fields: [kpiId], references: [id])
  value        Float
  updatedById  String?  // Who updated this
  note         String?  // Optional note about the change
  recordedAt   DateTime @default(now())
  @@index([kpiId])
  @@index([recordedAt])
}
model OrgGoal {
  id          String   @id @default(cuid())
  title       String              // "Generate ₦100B in 2026"
  description String?
  totalTarget Float
  unit        String
  year        Int
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  contributions KPI[]
}
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      NotifType @default(INFO)
  read      Boolean   @default(false)
  link      String?
  actionUrl String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  detail    String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model InternLog {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  date            DateTime  @default(now())
  taskTitle       String
  description     String
  skillsLearned   String?
  supervisorName  String?
  hoursSpent      Float
  status          LogStatus @default(SUBMITTED)
  supervisorComment String?
  evidence        String?
  weekNumber      Int?
  createdAt       DateTime  @default(now())
}

model LeaveRequest {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  days            Int
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  approverComment String?
  createdAt       DateTime    @default(now())
}

model CheckIn {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  date            DateTime
  checkInAt       DateTime
  checkOutAt      DateTime?
  hoursWorked     Float?
  status          String    @default("PRESENT")
  note            String?
  ipAddress       String?
  checkOutIsOnPremises   Boolean?
  checkOutGpsLat         Float?
  checkOutGpsLng         Float?
  checkOutLocationMethod String?
  isOnPremises    Boolean   @default(false)
  gpsLat          Float?
  gpsLng          Float?
  locationMethod  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  verificationMethod String?   // "FACE" | "FINGERPRINT" | "MANUAL_HR" | "OTP" | "UNVERIFIED"

  @@unique([userId, date])
  @@index([date])

}

model Exam {
  id          String        @id @default(cuid())
  title       String
  description String?
  targetRole  String
  gradeLevel  String?
  duration    Int
  passMark    Int           @default(60)
  isActive    Boolean       @default(false)
  questions   Question[]
  attempts    ExamAttempt[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Question {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  text          String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  marks         Int      @default(1)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

model ExamAttempt {
  id          String    @id @default(cuid())
  examId      String
  userId      String
  exam        Exam      @relation(fields: [examId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  answers     Json
  score       Int       @default(0)
  percentage  Int       @default(0)
  passed      Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  @@unique([examId, userId])
}

model Task {
  id                 String     @id @default(cuid())
  title              String
  description        String
  departmentId       String
  department         Department @relation(fields: [departmentId], references: [id])
  assignedToId       String?
  createdById        String
  assignedTo         User?      @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy          User       @relation("CreatedTasks",  fields: [createdById],  references: [id])
  priority           Priority   @default(MEDIUM)
  status             TaskStatus @default(PENDING)
  dueDate            DateTime?
  completedAt        DateTime?
  notes              String?
  caseReference      String?
  directorComment    String?
  dailyLogs DailyLog[]
  taskRef            String?    @unique
  forwardedFromId    String?
  forwardedToId      String?
  treatmentStatus    String?    @default("PENDING")
  documentData       String?
  documentName       String?
  documentType       String?
  documentSize       Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  office             String?
  forwardNote        String?
  escalationReason   String?
  escalatedAt        DateTime?
  isPaymentRequest   Boolean   @default(false)
  paymentRouting     String?
  paymentRecipientId String?
  taskSource         String?   @default("DEPARTMENT")
  forwardedFrom      User?     @relation("ForwardedFrom", fields: [forwardedFromId], references: [id])
  forwardedTo        User?     @relation("ForwardedTo", fields: [forwardedToId], references: [id])
  isBroadcastParent  Boolean  @default(false)   // NEW — true only on the "master" directive
  broadcastParentId  String?                     // NEW — set on each spawned child task
  broadcastParent    Task?    @relation("BroadcastChildren", fields: [broadcastParentId], references: [id]) // NEW
  broadcastChildren  Task[]   @relation("BroadcastChildren")   // NEW
}

model Announcement {
  id           String   @id @default(cuid())
  title        String
  body         String
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  targetDeptId String?
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChatConversation {
  id           String          @id @default(cuid())
  name         String?
  isGroup      Boolean         @default(false)
  participants ChatParticipant[]
  messages     ChatMessage[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ChatParticipant {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  lastReadAt     DateTime?
  createdAt      DateTime         @default(now())
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User             @relation(fields: [senderId], references: [id])
  content        String?
  fileUrl        String?
  fileName       String?
  fileType       String?
  edited         Boolean          @default(false)
  replyToId      String?
  replyTo        ChatMessage?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]    @relation("MessageReplies")
  pinned  Boolean  @default(false)   // ← ADD THIS
  reactions      ChatReaction[]
  createdAt      DateTime         @default(now())
  @@index([conversationId, createdAt])
  @@index([conversationId, senderId, createdAt])
}

model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime    @default(now())
  @@unique([messageId, userId])
}

model Memo {
  id          String          @id @default(cuid())
  subject     String
  body        String
  senderId    String
  sender      User            @relation(fields: [senderId], references: [id])
  fileUrl     String?
  fileName    String?
  fileType    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  recipients  MemoRecipient[]
}

model MemoRecipient {
  id        String    @id @default(cuid())
  memoId    String
  memo      Memo      @relation(fields: [memoId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model RevenueItem {
  id            String    @id @default(cuid())
  title         String
  amount        Float
  source        String
  reference     String?
  department    String?
  notes         String?
  documentData  String?
  documentName  String?
  documentType  String?
  status        String    @default("PENDING_EVC_APPROVAL")
  evcComment    String?
  submittedById String
  submittedBy   User      @relation("SubmittedRevenue", fields: [submittedById], references: [id])
  reviewedById  String?
  reviewedBy    User?     @relation("ReviewedRevenue",  fields: [reviewedById],  references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
}

model EVCAnnotation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("EVCAnnotations", fields: [userId], references: [id])
  subject   String
  content   String
  priority  String   @default("NORMAL")
  createdAt DateTime @default(now())
}

model EVCVaultFile {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation("EVCVault", fields: [ownerId], references: [id])
  title       String
  description String?
  category    String
  fileName    String
  fileType    String
  fileSize    Int
  fileData    String
  isEncrypted Boolean  @default(false)
  tags        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EVCTask {
  id              String    @id @default(cuid())
  title           String
  description     String
  assignedToId    String
  createdById     String
  assignedTo      User      @relation("EVCAssignedTasks",  fields: [assignedToId], references: [id])
  createdBy       User      @relation("EVCCreatedTasks",   fields: [createdById],  references: [id])
  priority        String    @default("HIGH")
  status          String    @default("PENDING")
  category        String    @default("General")
  isConfidential  Boolean   @default(false)
  dueDate         DateTime?
  completedAt     DateTime?
  evcComment      String?
  notes           String?
  documentData    String?
  documentName    String?
  documentType    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model RegisteredBusiness {
  id              String    @id @default(cuid())
  businessName    String
  rcNumber        String    @unique
  tin             String?   @unique
  sector          String
  email           String    @unique
  phone           String
  address         String
  state           String
  contactPerson   String
  contactRole     String
  password        String
  status          BizStatus @default(PENDING_VERIFICATION)
  registrationFee Float     @default(50000)
  feePaid         Boolean   @default(false)
  feeReference    String?
  verifiedAt      DateTime?
  verifiedById    String?
  notes           String?
  complianceScore Int       @default(0)
  complianceReports ComplianceReport[]
  fines             ComplianceFine[]
  payments          BizPayment[]
  auditLogs         BizAuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComplianceReport {
  id             String    @id @default(cuid())
  businessId     String
  business       RegisteredBusiness @relation(fields: [businessId], references: [id])
  reportType     String
  title          String
  description    String
  period         String
  attachmentUrl  String?
  status         ReportStatus @default(SUBMITTED)
  reviewedById   String?
  reviewNote     String?
  reviewedAt     DateTime?
  submittedAt    DateTime  @default(now())
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
}

model ComplianceFine {
  id             String    @id @default(cuid())
  businessId     String
  business       RegisteredBusiness @relation(fields: [businessId], references: [id])
  reason         String
  amount         Float
  paid           Boolean   @default(false)
  paidAt         DateTime?
  paidReference  String?
  issuedById     String?
  dueDate        DateTime
  status         FineStatus @default(UNPAID)
  notes          String?
  payments       BizPayment[]
  createdAt      DateTime  @default(now())
}

model BizPayment {
  id           String    @id @default(cuid())
  businessId   String
  business     RegisteredBusiness @relation(fields: [businessId], references: [id])
  fineId       String?
  fine         ComplianceFine? @relation(fields: [fineId], references: [id])
  amount       Float
  type         PaymentType
  reference    String    @unique
  status       PaymentStatus @default(PENDING)
  confirmedAt  DateTime?
  confirmedById String?
  notes        String?
  createdAt    DateTime  @default(now())
}

model BizAuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   RegisteredBusiness @relation(fields: [businessId], references: [id])
  action     String
  detail     String?
  doneById   String?
  createdAt  DateTime @default(now())
}

model PaymentWorkflow {
  id              String   @id @default(cuid())
  caseReference   String
  caseType        String
  companyName     String
  expectedAmount  Float
  actualAmount    Float?
  currency        String   @default("NGN")
  notes           String?
  status          PaymentWorkflowStatus @default(PENDING_CONFIRMATION)
  raisedById      String
  raisedBy        User     @relation("RaisedPayments", fields: [raisedById], references: [id])
  confirmedById   String?
  confirmedBy     User?    @relation("ConfirmedPayments", fields: [confirmedById], references: [id])
  bankReference   String?
  paymentDate     DateTime?
  financeNotes    String?
  documentUrl     String?
  documentName    String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CaseTransfer {
  id              String         @id @default(cuid())
  caseRef         String
  caseTitle       String
  caseType        String
  description     String
  fromOffice      String
  toOffice        String
  transferType    TransferType
  priority        Priority       @default(MEDIUM)
  status          TransferStatus @default(PENDING_ACCEPTANCE)
  transferNote    String
  attachmentUrl   String?
  attachmentName  String?
  initiatedById   String
  initiatedBy     User           @relation("InitiatedTransfers", fields: [initiatedById], references: [id])
  acceptedById    String?
  acceptedBy      User?          @relation("AcceptedTransfers", fields: [acceptedById], references: [id])
  rejectedReason  String?
  completedNote   String?
  targetUserId    String?
  targetUser      User?          @relation("TargetTransfers", fields: [targetUserId], references: [id])
  dueDate         DateTime?
  acceptedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  credentialId String   @unique
  publicKey    String   @db.Text
  counter      Int      @default(0)
  deviceLabel  String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
}

model BiometricActivationCode {
  id          String    @id @default(cuid())
  code        String    @unique
  userId      String
  user        User      @relation("UserActivations", fields: [userId], references: [id])
  createdById String
  createdBy   User      @relation("CreatedActivations", fields: [createdById], references: [id])
  used        Boolean   @default(false)
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model ConsentRecord {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  version     String    @default("v1")
  ip          String?
  userAgent   String?
  consentedAt DateTime  @default(now())
}

model FaceData {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  embedding  String   @db.Text   // AES-256-GCM encrypted JSON array of numbers — face shape, not a photo
  algorithm  String   @default("face-api-ssd-128d")
  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BiometricAttempt {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  method          String            // "FACE" | "FINGERPRINT" | "MANUAL_HR" | "OTP"
  success         Boolean
  similarityScore Float?            // for face matches — how close it was, 0 to 1
  deviceLabel     String?
  ipAddress       String?
  createdAt       DateTime @default(now())
}

model HRCheckInApproval {
  id           String   @id @default(cuid())
  staffId      String
  staff        User     @relation("StaffHRApprovals", fields: [staffId], references: [id])
  approvedById String
  approvedBy   User     @relation("HRApprovers", fields: [approvedById], references: [id])
  reason       String            // e.g. "New phone, not yet enrolled"
  checkInId    String?  @unique
  createdAt    DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  code      String
  purpose   String   @default("CHECKIN_FALLBACK")
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AccountActivationCode {
  id          String    @id @default(cuid())
  code        String    @unique
  email       String            // the account doesn't exist yet, so we key this by email, not userId
  role        Role      @default(STAFF)
  createdById String?           // null only for the one-time bootstrap admin
  used        Boolean   @default(false)
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

// Tracks an active or pending screen-share session between two users
model ScreenShareSession {
  id            String                @id @default(cuid())
  requesterId   String                // User who initiates the view request
  targetId      String                // User being watched
  status        ScreenShareStatus     @default(PENDING)
  startedAt     DateTime?             // When target accepted
  endedAt       DateTime?             // When session ended
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  requester     User                  @relation("ScreenShareRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  target        User                  @relation("ScreenShareTargets",   fields: [targetId],   references: [id], onDelete: Cascade)
  heartbeats    ScreenShareHeartbeat[]
  auditLogs     ScreenShareAuditLog[]
  signals  ScreenShareSignal[]
  @@index([requesterId])
  @@index([targetId])
  @@index([status])
}

// Each heartbeat = one snapshot of what the target user is doing
model ScreenShareHeartbeat {
  id          String   @id @default(cuid())
  sessionId   String
  currentUrl  String   // e.g. "/dashboard/performance"
  pageTitle   String?
  clickEvent  Json?    // { x, y, selector, text } — last click
  actionEvent Json?    // { type: "modal_open"|"form_submit"|"navigation", detail }
  inputEvent  Json?    // { field, maskedValue } — masked typing data
  scrollY     Int?     // scroll position
  timestamp   DateTime @default(now())

  session     ScreenShareSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
}

// Immutable audit trail — who viewed whom, when, for how long
model ScreenShareAuditLog {
  id          String   @id @default(cuid())
  sessionId   String
  action      String   // "REQUESTED" | "ACCEPTED" | "REJECTED" | "ENDED_BY_REQUESTER" | "ENDED_BY_TARGET"
  actorId     String   // Who performed this action
  metadata    Json?    // extra context
  createdAt   DateTime @default(now())

  session     ScreenShareSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([actorId])
}

// Stores WebRTC signaling data (offer, answer, ICE candidates)
// Used as a polling-based signaling channel between two browsers
model ScreenShareSignal {
  id          String   @id @default(cuid())
  sessionId   String
  fromUserId  String   // who sent this signal
  toUserId    String   // who should receive it
  type        String   // "offer" | "answer" | "ice-candidate" | "end"
  payload     Json     // the actual SDP or ICE candidate data
  consumed    Boolean  @default(false) // mark as read so we don't re-process
  createdAt   DateTime @default(now())
  session     ScreenShareSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, toUserId, consumed])
  @@index([createdAt])
}

model IncentiveRecommendation {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  month            String    // "2026-08" format
  segment          String    // FRONTLINE | SUPERVISORY | LEADERSHIP
  rank             Int
  performanceIndex Float
  taskCount        Int
  avgScore         Float?
  status           String    @default("PENDING") // PENDING | ACKNOWLEDGED | ACTIONED | DISMISSED
  hrNote           String?
  actionedById     String?
  actionedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([userId, month])
}

